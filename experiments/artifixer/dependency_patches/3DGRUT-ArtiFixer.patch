--- /dev/null
+++ b/threedgrut/model/region_supervision.py
@@ -0,0 +1,115 @@
+"""Opt-in trusted-pixel supervision with strict local perceptual support."""
+from pathlib import Path
+import hashlib
+import json
+import re
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+
+def weighted_terms(pred, target, weight, lpips=None, patch_size=32, max_patches=8):
+    """NHWC RGB. Unknown pixels are never used as RGB or perceptual inputs."""
+    if pred.shape != target.shape or pred.ndim != 4 or pred.shape[-1] != 3:
+        raise ValueError('RGB must be matching NHWC tensors')
+    if weight.shape != pred.shape[:-1] or not torch.isfinite(weight).all() or (weight < 0).any():
+        raise ValueError('Weights must be finite nonnegative NHW')
+    valid = weight > 0
+    zero = pred.reshape(-1)[:0].sum()
+    if not valid.any():
+        return dict(l1=zero, l2=zero, ssim=zero, lpips=zero, trusted_patches=0)
+    selected_pred, selected_target = pred[valid], target[valid]
+    if not torch.isfinite(selected_pred).all() or not torch.isfinite(selected_target).all():
+        raise ValueError('Nonfinite trusted RGB')
+    w = weight[valid]
+    l1 = ((selected_pred-selected_target).abs().mean(-1)*w).sum()/w.sum()
+    l2 = ((selected_pred-selected_target).square().mean(-1)*w).sum()/w.sum()
+    # Select crops only if every pixel is trusted. Do not black out unknown pixels.
+    ss, perceptual, crop_weights = [], [], []
+    stride=max(1,patch_size//2)
+    for b in range(pred.shape[0]):
+        for y in range(0,pred.shape[1]-patch_size+1,stride):
+            for x in range(0,pred.shape[2]-patch_size+1,stride):
+                v=valid[b,y:y+patch_size,x:x+patch_size]
+                if not v.all():continue
+                a=pred[b:b+1,y:y+patch_size,x:x+patch_size].permute(0,3,1,2)
+                t=target[b:b+1,y:y+patch_size,x:x+patch_size].permute(0,3,1,2)
+                ma=F.avg_pool2d(a,11,1);mt=F.avg_pool2d(t,11,1)
+                va=(F.avg_pool2d(a*a,11,1)-ma*ma).clamp_min(0)
+                vt=(F.avg_pool2d(t*t,11,1)-mt*mt).clamp_min(0)
+                cov=F.avg_pool2d(a*t,11,1)-ma*mt
+                similarity=((2*ma*mt+.01**2)*(2*cov+.03**2))/((ma*ma+mt*mt+.01**2)*(va+vt+.03**2))
+                ss.append(1-similarity.mean())
+                if lpips is not None:perceptual.append(lpips(a.clamp(0,1),t.clamp(0,1)).mean())
+                crop_weights.append(weight[b,y:y+patch_size,x:x+patch_size].mean())
+                if len(crop_weights)>=max_patches:break
+            if len(crop_weights)>=max_patches:break
+        if len(crop_weights)>=max_patches:break
+    if crop_weights:
+        cw=torch.stack(crop_weights)
+        ssim=(torch.stack(ss)*cw).sum()/cw.sum()
+        perceptual_loss=(torch.stack(perceptual)*cw).sum()/cw.sum() if perceptual else zero
+    else:ssim=perceptual_loss=zero
+    return dict(l1=l1,l2=l2,ssim=ssim,lpips=perceptual_loss,trusted_patches=len(crop_weights))
+
+
+class RegionSupervision:
+    def __init__(self, config, trainer_config):
+        self.config=config
+        self.path=Path(config['manifest']).resolve()
+        self.root=self.path.parent
+        self.manifest=json.loads(self.path.read_text())
+        self.rows={int(r['frame']):r for r in self.manifest['frames']}
+        self.allowed=set(self.manifest['training_eligible_frames'])
+        self.cache={}
+        provenance=json.loads((self.root/'initialization/provenance.json').read_text())
+        if trainer_config.get('resume'):
+            raise ValueError('Region supervision requires original PLY initialization; resume is forbidden')
+        imp=trainer_config['import_ply']
+        if not imp['enabled'] or int(imp.get('init_global_step',0))!=0 or trainer_config['import_ingp']['enabled']:
+            raise ValueError('Original PLY at step zero is required')
+        initial=Path(imp['path'])
+        if hashlib.sha256(initial.read_bytes()).hexdigest()!=provenance['sha256']:
+            raise ValueError('Initialization hash does not match original object_local.ply')
+        if trainer_config.get('image_path_override') is not None:
+            raise ValueError('Use an explicit target dataset with image_path_override=null; legacy override splits can include holdouts')
+
+    @staticmethod
+    def frame_id(name):
+        m=re.fullmatch(r'(?:frame_)?(\d+)',Path(name).stem)
+        if not m:raise ValueError(f'Unknown supervision image identifier: {name}')
+        return int(m.group(1))
+
+    def validate_training_dataset(self, dataset):
+        seen=set()
+        camera_doc=json.loads((self.root/'cameras/transforms.json').read_text())
+        for index,path in enumerate(dataset.image_paths):
+            frame=self.frame_id(path)
+            if frame not in self.allowed or self.rows[frame]['split']!='train':
+                raise ValueError(f'Unapproved or held-out frame {frame} present in training dataset')
+            row=self.rows[frame]
+            expected_pose=np.asarray(camera_doc['frames'][frame]['transform_matrix'],dtype=np.float64).copy()
+            expected_pose[:3,1:3]*=-1
+            if not np.allclose(dataset.poses[index],expected_pose,atol=1e-5,rtol=0):
+                raise ValueError(f'Camera changed from original: frame {frame}')
+            expected=self.root/row['supervision_target']
+            if hashlib.sha256(Path(path).read_bytes()).digest()!=hashlib.sha256(expected.read_bytes()).digest():
+                raise ValueError(f'Target pixels do not match accepted supervision: frame {frame}')
+            seen.add(frame)
+        if seen!=self.allowed:raise ValueError(f'Training dataset must exactly match approved frames: {seen} vs {self.allowed}')
+
+    def losses(self, pred, target, image_name, lpips=None, mask=None):
+        frame=self.frame_id(image_name)
+        row=self.rows[frame]
+        if frame not in self.cache:
+            self.cache[frame]=np.load(self.root/row['effective_weight']).astype(np.float32)
+        weights=torch.as_tensor(self.cache[frame],device=pred.device,dtype=pred.dtype)
+        if tuple(weights.shape)!=tuple(pred.shape[1:3]):raise ValueError('RGB and supervision resolution must match; no implicit mask resizing')
+        weights=weights[None].expand(pred.shape[0],-1,-1)
+        if mask is not None:weights=weights*(mask.squeeze(-1)>0.5)
+        terms=weighted_terms(pred,target,weights,lpips=lpips if float(self.config.get('lambda_lpips',.02)) else None)
+        l1=float(self.config.get('lambda_l1',.8))*terms['l1']
+        ssim=float(self.config.get('lambda_ssim',.2))*terms['ssim']
+        perceptual=float(self.config.get('lambda_lpips',.02))*terms['lpips']
+        zero=pred.reshape(-1)[:0].sum()
+        return dict(total_loss=l1+ssim+perceptual,l1_loss=l1,l2_loss=zero,ssim_loss=ssim,lpips_loss=perceptual,opacity_loss=zero,scale_loss=zero)
